{
    "id": "canonical-query",
    "cases": [
        {
            "input": {
                "z": "last",
                "a": "first",
                "m": "middle"
            },
            "expected": "a=first&m=middle&z=last"
        },
        {
            "input": [],
            "expected": ""
        },
        {
            "input": {
                "key": "a b",
                "arr": [
                    "x",
                    "y"
                ]
            },
            "expected": "arr=x%2Cy&key=a%20b"
        },
        {
            "input": {
                "a!": "x",
                "b*": "y",
                "c'": "z",
                "d(": ")"
            },
            "expected": "a%21=x&b%2A=y&c%27=z&d%28=%29"
        }
    ]
}
